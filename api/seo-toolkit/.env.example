# API Environment Variables
# Copy to .env and adjust for your environment. Never commit the real .env file.

APP_ENV=development
# development | production — production hides internal error detail from responses

# Comma-separated list of allowed CORS origins for local/dev cross-origin requests.
# In production, prefer same-origin (frontend and /api served from the same domain) and leave this empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: absolute path to a CA bundle (cacert.pem) for outbound cURL SSL
# verification. Only needed on environments where PHP/cURL can't locate a
# system CA store (some local Windows setups). Leave empty in production —
# Hostinger's Linux hosting already has a system bundle configured.
CURL_CA_BUNDLE_PATH=

# Optional Google PageSpeed Insights API key (mirrors the Node PAGESPEED_API_KEY behaviour).
# When unset, performance/accessibility scores fall back to the HTML-heuristic analysis.
PAGESPEED_API_KEY=

# Trusted reverse-proxy IPs allowed to set X-Forwarded-For for rate limiting / IP logging.
# Leave empty to always use the raw connecting IP (REMOTE_ADDR).
TRUSTED_PROXIES=

# Rate limits (requests per window per client IP)
RATE_LIMIT_AUDITS_PER_HOUR=5
RATE_LIMIT_COMPETITORS_PER_HOUR=3
RATE_LIMIT_STATUS_PER_MINUTE=60
RATE_LIMIT_PDF_PER_HOUR=5

# Storage retention (hours)
AUDIT_RETENTION_HOURS=24
REPORT_RETENTION_HOURS=24
