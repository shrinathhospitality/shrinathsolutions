# This project does not use a .env loader in production — api/config/config.php holds the
# real database credentials directly (gitignored) and is read by every PHP entry point.
# The two environment variables below are CLI-only conveniences for local development;
# neither is required, and neither should be set on the production server.

# Overrides the DB host used by api/config/config.php, api/database/migrate.php and every
# database/seed_*.php script. Leave unset in production (defaults to 'localhost', which only
# resolves from inside the Hostinger account). Set to the Remote MySQL host/IP when running
# migrations or testing the API from your own machine — see DATABASE_SETUP.md.
DB_HOST=

# Read once by database/seed_admin.php when creating the first admin account. If unset, the
# seeder falls back to the documented temporary password "admin123". Set this to seed a
# stronger temporary password instead, e.g. before a fresh production deploy.
ADMIN_SEED_PASSWORD=
