api/seo-toolkit/storage/logs/*
!api/seo-toolkit/storage/logs/.gitkeep
api/seo-toolkit/storage/rate-limits/*
!api/seo-toolkit/storage/rate-limits/.gitkeep
api/seo-toolkit/storage/reports/*
!api/seo-toolkit/storage/reports/.gitkeep
