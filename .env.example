# This project does not use a .env loader in production — api/config/config.php holds the
# real database credentials directly (gitignored) and is read by every PHP entry point.
# The two environment variables below are CLI-only conveniences for local development;
# neither is required, and neither should be set on the production server.

# Overrides the DB host used by api/config/config.php, api/database/migrate.php and every
# database/seed_*.php script. Leave unset in production (defaults to 'localhost', which only
# resolves from inside the Hostinger account). Set to the Remote MySQL host/IP when running
# migrations or testing the API from your own machine — see DATABASE_SETUP.md.
DB_HOST=

# Read once by database/seed_admin.php when creating the first admin account. If unset, the
# seeder falls back to the documented temporary password "admin123". Set this to seed a
# stronger temporary password instead, e.g. before a fresh production deploy.
ADMIN_SEED_PASSWORD=

# --- Frontend build-time vars (Vite only reads variables prefixed VITE_, and inlines them
# into the client bundle at build time — never put a secret in a VITE_ var). ---

# GA4 measurement id (e.g. "G-XXXXXXXXXX"). Leave unset to fully disable analytics: with no
# id, src/lib/analytics.ts never injects the gtag.js script and every tracking call is a
# no-op. Set this in the GitHub Actions build environment (not committed) once a real GA4
# property exists — see SEO_IMPLEMENTATION.md's analytics section.
VITE_GA4_MEASUREMENT_ID=

# --- Build-time-only prerendering vars (npm run build:prerender / scripts/prerender.mjs).
# Never read by the browser bundle, never prefixed VITE_ on purpose. ---

# Origin used to fetch the route source (sitemap.xml) during prerendering, and as the base
# for canonical/OG URLs already baked into every page via Seo.tsx. Leave unset to default to
# the real production origin (https://shrinathsolutions.com) — never set this to localhost.
PRERENDER_SITE_URL=

# Origin the dynamic-page loaders (src/loaders/*.ts) fetch against during prerendering. Leave
# unset to default to PRERENDER_SITE_URL — the same public, read-only, published-content-only
# API every visitor's browser already calls, so no database connection or credentials are
# needed to prerender. Override only to point the build at a staging API.
PRERENDER_API_BASE_URL=
